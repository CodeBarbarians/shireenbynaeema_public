        "NameInSource": "azureSql",
        "SqlCommand": "SELECT \r\n\tm.Id AS id,\r\n\tm.Type AS type,\r\n\tm.FileName AS fileName,\r\n\tm.Extension AS extension,\r\n\tm.WorkOrderId AS workOrderId,\r\n\tm.MediaNoteText AS mediaNoteText,\r\n\tCASE \r\n        WHEN m.MediaNoteText IS NULL OR LTRIM(RTRIM(m.MediaNoteText)) = '' \r\n            THEN CAST(0 AS bit)  -- hide note\r\n        ELSE CAST(1 AS bit)      -- show note\r\n    END AS showNote,\r\n    '{blobbaseURL}' + '/' + m.Path AS path\r\nFROM WorkOrderMedia m\r\nWHERE \r\n    m.Type = 3\r\n    AND m.WorkOrderId = '{WOId}'\r\n    AND (\r\n        LOWER(m.Extension) IN ('.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.tif', '.tiff')\r\n    )\r\nORDER BY \r\n    m.Id;\r\n"
      },
      "5": {
        "Ident": "StiSqlSource",
