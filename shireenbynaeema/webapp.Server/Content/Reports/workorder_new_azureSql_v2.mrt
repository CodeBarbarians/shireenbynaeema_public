          },
          "6": {
            "Name": "path",
            "Index": -1,
            "NameInSource": "path",
            "Alias": "path",
            "Type": "System.String"
          },
          "7": {
            "Name": "iteration",
            "Index": -1,
            "NameInSource": "iteration",
            "Alias": "iteration",
            "Type": "System.Int32"
          },
          "8": {
