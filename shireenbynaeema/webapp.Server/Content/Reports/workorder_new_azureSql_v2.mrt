            "Type": "System.String"
          }
        },
        "NameInSource": "azureSql",
        "SqlCommand": "SELECT DISTINCT\r\n\tm.Id AS id,\r\n\tm.Type AS type,\r\n\tm.FileName AS fileName,\r\n\tm.Extension AS extension,\r\n\tm.WorkOrderId AS workOrderId,\r\n\tm.MediaNoteText AS mediaNoteText,\r\n\ta.SignatureContactName as signatureContactName,\r\n\t'{blobbaseURL}'+'/'+m.Path AS path\r\n\tFROM WorkOrderMedia m\r\nLEFT JOIN WorkOrderActions a \r\n    ON a.WorkOrderId = m.WorkOrderId \r\n    AND a.StepNo = 5\r\nWHERE \r\n    m.Iteration = '{iterationNo}' \r\n    AND m.WorkOrderId = '{WOId}' \r\n    AND m.Type = 4 \r\n    AND a.SignatureContactName IS NOT NULL;\r\n"
      },
