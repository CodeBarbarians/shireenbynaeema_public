            "Type": "System.Boolean"
          }
        },
        "NameInSource": "azureSql",
        "SqlCommand": "SELECT \r\n\tm.Id AS id,\r\n\tm.Type AS type,\r\n\tm.FileName AS fileName,\r\n\tm.Extension AS extension,\r\n\tm.WorkOrderId AS workOrderId,\r\n\tm.MediaNoteText AS mediaNoteText,\r\n\tm.Iteration AS iteration,\r\n\tCASE \r\n        WHEN m.MediaNoteText IS NULL OR LTRIM(RTRIM(m.MediaNoteText)) = '' \r\n            THEN CAST(0 AS bit)  -- means: hide note\r\n        ELSE CAST(1 AS bit)      -- means: show note\r\n    END AS showNote,\r\n    '{blobbaseURL}' + '/' + m.Path AS path\r\nFROM WorkOrderMedia m\r\nWHERE \r\n    m.WorkOrderId = '{WOId}' \r\n    AND m.Type = 1\r\n    AND (\r\n        {iterationNo} IS NULL \r\n        OR {iterationNo} = '' \r\n        OR m.Iteration = CAST({iterationNo} AS INT)\r\n    )\r\nORDER BY \r\n    m.Iteration, \r\n    m.Id;\r\n"
      },
      "3": {
