        "NameInSource": "azureSql",
        "SqlCommand": "SELECT \r\n\to.Id AS id,\r\n\to.WOId AS woId,\r\n\to.WOCode AS woCode,\r\n\to.RequestRefCode AS requestRefCode,\r\n\to.SubClient AS subClient,\r\n\tISNULL(sc.Name, '') AS subClientName,\r\n\to.ServiceDescriptionClientSide AS serviceDescription,\r\n\t\r\n\t-- ✅ Use note from lastSignOut if available, else ServiceResolutionDescription\r\n\tISNULL(\r\n\t(\r\n\tSELECT TOP 1 wa.Notes\r\n\t\tFROM WorkOrderActions wa\r\n\t\tWHERE wa.WorkOrderId = o.Id\r\n\t\t AND (\r\n        {iterationNo} IS NULL \r\n        OR {iterationNo} = '' \r\n        OR wa.IterationNo = CAST({iterationNo} AS INT))\r\n\t\t  AND wa.Status = '30'\r\n\t\t  AND wa.ActionType IN ('6','4','3','5')\r\n\t\tORDER BY wa.CreatedOn DESC, wa.StepNo DESC\r\n\t), o.ServiceResolutionDescription\r\n\t) AS serviceResolutionDescription,\r\n\to.LocationId AS locationId,\r\n\tISNULL(l.ICheck_PropertyCode, '') AS siteId,\r\n\tISNULL(\r\n\tl.ICheck_PropertyCode + ' - ' + l.ICheck_Address1 + ' - ' + l.ICheck_City + ' - ' + prov.ICheck_ProvinceName + ' - ' + l.ICheck_PostalCode,\r\n\t''\r\n\t) AS siteAddress,\r\n\to.SiteContactName AS siteContactName,\r\n\to.SiteContactNo AS siteContactNo,\r\n\to.ServiceId AS serviceId,\r\n\tISNULL(s.ICheck_ServiceName, '') AS serviceName,\r\n\to.PriorityId AS priorityId,\r\n\tISNULL(p.ICheck_ResponseTimeCode, '') AS priorityName,\r\n\to.NTE AS nte,\r\n\to.TargetCompletionDate AS targetCompletionDate,\r\n\to.Status AS status,\r\n\t-- ✅ Dynamic flags\r\n\tCASE WHEN ISNULL(o.ServiceResolutionDescription, '') <> '' THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showsResolution,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkerOrderNote wn \r\n\t\tWHERE wn.WorkOrderId = o.Id \r\n\t\t  AND wn.ICheck_NotePrivate = 0\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showNotes,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkOrderMedia wm \r\n\t\tWHERE wm.WorkOrderId = o.Id\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showMedia,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkOrderMedia wm \r\n\t\tWHERE wm.WorkOrderId = o.Id AND wm.Type = 1\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showBeforeMedia,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkOrderMedia wm \r\n\t\tWHERE wm.WorkOrderId = o.Id AND wm.Type = 2\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showAfterMedia,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkOrderMedia wm \r\n\t\tWHERE wm.WorkOrderId = o.Id AND wm.Type = 3\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showOtherMedia,\r\n    CASE WHEN EXISTS (\r\nSELECT 1 \r\n\tFROM WorkOrderMedia wm \r\n\t\tWHERE wm.WorkOrderId = o.Id AND wm.Type = 4\r\n    ) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS showSignatureMedia,\r\n    \r\n    -- ✅ Convert INT Unix → datetime2 + formatted string (UTC-5)\r\n    DATEADD(HOUR, -5, DATEADD(SECOND, o.TargetCompletionDate, '1970-01-01')) AS targetCompletionDateDateTime,\r\n    FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, o.TargetCompletionDate, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt') AS targetCompletionDateFormatted,\r\n    DATEADD(HOUR, -5, DATEADD(SECOND, o.CreatedOn, '1970-01-01')) AS createdOnDateTime,\r\n    FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, o.CreatedOn, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt') AS createdOnFormatted,\r\n    DATEADD(HOUR, -5, DATEADD(SECOND, o.UpdatedOn, '1970-01-01')) AS updatedOnDateTime,\r\n    FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, o.UpdatedOn, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt') AS updatedOnFormatted,\r\n    \r\n    -- ✅ Status text from WOStatus table\r\n    wos.ICheck_StatusDesc as statusText\r\nFROM WorkOrder o\r\nLEFT JOIN CustomerPriority p ON o.PriorityId = p.Id\r\nLEFT JOIN Service s ON o.ServiceId = s.Id\r\nLEFT JOIN SubClient sc ON o.SubClient = sc.Id\r\nLEFT JOIN SubClientLocation l ON o.LocationId = l.Id\r\nLEFT JOIN Province prov ON l.ICheck_Province = prov.ICheck_ProvinceID\r\nLEFT JOIN WOStatus wos ON o.Status = wos.ICheck_StatusID\r\nWHERE o.Id = '{WOId}';"
      },
      "1": {
        "Ident": "StiSqlSource",
        "Name": "notes",
