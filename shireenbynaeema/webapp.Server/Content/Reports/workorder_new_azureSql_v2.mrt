            "Type": "System.String"
          },
          "25": {
            "Name": "JobOutcomeFormatted",
            "Index": -1,
            "NameInSource": "JobOutcomeFormatted",
            "Alias": "JobOutcomeFormatted",
            "Type": "System.String"
          },
          "26": {
            "Name": "ReturnDateTimeUnixFormatted",
            "Index": -1,
            "NameInSource": "ReturnDateTimeUnixFormatted",
            "Alias": "ReturnDateTimeUnixFormatted",
            "Type": "System.String"
          }
        },
        "NameInSource": "azureSql",
        "SqlCommand": "SELECT \r\n\tId,\r\n\tWorkOrderId,\r\n\tISNULL(CAST(ActionType AS VARCHAR), '-') AS ActionType,\r\n    CASE \r\n        WHEN ActionType = 1 THEN 'Pause'                    -- MaterialRequired\r\n        WHEN ActionType = 2 THEN 'Pause'                    -- ReturnVisitRequired\r\n        WHEN ActionType = 5 THEN 'Completed'                -- Completed\r\n        WHEN ActionType = 3 THEN 'Sign-Out'                 -- QuoteRequired\r\n        WHEN ActionType = 4 THEN 'Sign-Out'                 -- DifferentTradeRequired\r\n        WHEN ActionType = 6 THEN 'Sign-Out'                 -- Other\r\n        WHEN StepNo = 1 THEN 'Sign-In'                      -- Step1_SignIn\r\n        WHEN StepNo = 6 THEN 'Returned to Site'             -- Step2_1_Resume\r\n        ELSE '-'\r\n    END AS TypeFormatted,\r\n    CASE \r\n        WHEN ActionType = 1 THEN 'Material Required'        -- MaterialRequired\r\n        WHEN ActionType = 2 THEN 'Return Visit Required'    -- ReturnVisitRequired\r\n        WHEN ActionType = 5 THEN 'Completed'                -- Completed\r\n        WHEN ActionType = 3 THEN 'Quote Required'           -- QuoteRequired\r\n        WHEN ActionType = 4 THEN 'Different Trade Required' -- DifferentTradeRequired\r\n        WHEN ActionType = 6 THEN 'Other'                    -- Other\r\n        WHEN StepNo = 1 THEN 'Sign-In'                      -- Step1_SignIn\r\n        WHEN StepNo = 6 THEN 'Returned to Site'             -- Step2_1_Resume\r\n        ELSE '-'\r\n    END AS JobOutcomeFormatted,\r\n    ISNULL(Notes, '-') AS Notes,\r\n    ISNULL(CAST(StepNo AS VARCHAR), '-') AS StepNo,\r\n    ISNULL(CAST(ReturnDateTimeUnix AS VARCHAR), '-') AS ReturnDateTimeUnix,\r\n    ISNULL(CAST(SignatureObtained AS VARCHAR), '-') AS SignatureObtained,\r\n    ISNULL(SignatureContactName, '-') AS SignatureContactName,\r\n    ISNULL(SignatureUnableReason, '-') AS SignatureUnableReason,\r\n    ISNULL(SignatureOtherReason, '-') AS SignatureOtherReason,\r\n    ISNULL(CAST(Status AS VARCHAR), '-') AS Status,\r\n    CreatedOn,\r\n    ISNULL(FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, CreatedOn, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt'), '-') AS CreatedOnFormatted,\r\n    UpdatedOn,\r\n    ISNULL(FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, UpdatedOn, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt'), '-') AS UpdatedOnFormatted,\r\n    ISNULL(CAST(CreatedBy AS VARCHAR(50)), '-') AS CreatedBy,\r\n    ISNULL(CAST(UpdatedBy AS VARCHAR(50)), '-') AS UpdatedBy,\r\n    ISNULL(VendorEmail, '-') AS VendorEmail,\r\n    ISNULL(LocationNotes, '-') AS LocationNotes,\r\n    ISNULL(CAST(IterationNo AS VARCHAR), '-') AS IterationNo,\r\n    ReturnDateTime,\r\n    ISNULL(FORMAT(ReturnDateTime, 'MMM dd, yyyy, hh:mm tt'), '-') AS ReturnDateTimeFormatted,\r\n    ISNULL(FORMAT(DATEADD(HOUR, -5, DATEADD(SECOND, ReturnDateTimeUnix, '1970-01-01')), 'MMM dd, yyyy, hh:mm tt'), '-') AS ReturnDateTimeUnixFormatted,\r\n    ISNULL(CAST(Latitude AS VARCHAR), '-') AS Latitude,\r\n    ISNULL(CAST(Longitude AS VARCHAR), '-') AS Longitude,\r\n\tVendorEmail\r\nFROM WorkOrderActions \r\nWHERE WorkOrderId = '{WOId}' \r\n  AND StepNo != 4 AND StepNo != 2  -- Exclude Step4_AfterPhotos and Step2_BeforePhotos\r\n  AND (\r\n        {iterationNo} IS NULL \r\n        OR {iterationNo} = '' \r\n        OR IterationNo = CAST({iterationNo} AS INT)\r\n      )\r\nAND (\r\n        '{VendorEmail}' IS NULL \r\n        OR '{VendorEmail}' = '' \r\n        OR VendorEmail = '{VendorEmail}'\r\n      )\r\nORDER BY IterationNo, CreatedOn;"
      }
    },
