        "NameInSource": "azureSql",
        "SqlCommand": "SELECT\r\n\twon.Id AS noteId,\r\n\twon.ICheck_Note AS iCheckNote,\r\n\twon.ICheck_CreatedOn AS iCheckCreatedOn,\r\n\twon.ICheck_ModifiedOn AS iCheckModifiedOn,\r\n\tusr.ICheck_FirstName + ' ' + usr.ICheck_LastName AS iCheckCreatedBy,\r\n\tmodusr.ICheck_FirstName + ' ' + modusr.ICheck_LastName AS iCheckModifiedBy\r\n\tFROM WorkerOrderNote won\r\nLEFT JOIN Dispatch usr ON won.ICheck_CreatedBy = usr.ICheck_DSOperatorID\r\nLEFT JOIN Dispatch modusr ON won.ICheck_ModifiedBy = modusr.ICheck_DSOperatorID\r\nWHERE won.WorkOrderId = '{WOId}'\r\n  AND (won.ICheck_NotePrivate IS NULL OR won.ICheck_NotePrivate = 0)\r\nORDER BY won.ICheck_NoteID DESC;\r\n"
      },
      "2": {
