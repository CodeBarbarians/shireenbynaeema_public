    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;SA1518;SA1101;SA1505</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Stimulsoft.Reports.Engine.NetCore" Version="2025.4.1" />
    <PackageReference Include="Stimulsoft.Reports.Web.NetCore" Version="2025.4.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\webapp.Domain\webapp.Domain.csproj" />
  </ItemGroup>

</Project>
